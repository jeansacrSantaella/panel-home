# Copia a .env: main.py lo lee solo al arrancar
PANEL_HOST=127.0.0.1
PANEL_PORT=8770
NETWATCH_URL=http://127.0.0.1:8765
CAMARAS_URL=http://127.0.0.1:8080
# Vacío: el navegador usa http://<host de la página>:1984
GO2RTC_URL=
# 1 = pedir las capturas por HTTP a gestorCamaras (si panel-home corre en otra máquina)
FOTOS_REMOTAS=0
CAMARAS_DATA=../Camaras/gestorCamaras/data
# Comando que imprime {"mac o ip": {"rx": bytes, "tx": bytes}} con contadores acumulados (ver README)
CONSUMO_CMD=
RECOLECTAR_CADA=15
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Push al celular con la app ntfy: usa un tema difícil de adivinar
NTFY_URL=
# Tipos que se avisan (vacío = fuente_caida,fuente_ok; agrega movimiento para avisar cada detección; lo demás ya lo avisan NetWatch y gestorCamaras)
PANEL_AVISAR=
